{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "EVPanda",
  "description": "Observability for EV charging networks. Capture, validate, and search every OCPP and OCPI message your platform exchanges.",
  "colors": {
    "primary": "#4F46E5",
    "light": "#A5B4FC",
    "dark": "#6366F1"
  },
  "appearance": {
    "default": "dark"
  },
  "icons": {
    "library": "lucide"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://evpanda.io"
  },
  "navigation": {
    "pages": [
      "index",
      {
        "group": "Core concepts",
        "pages": [
          "concepts/networks",
          "concepts/identity",
          "concepts/capture-model"
        ]
      },
      {
        "group": "SDK integration",
        "pages": [
          "integration/getting-started",
          "integration/ocpp",
          "integration/ocpi"
        ]
      }
    ]
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Get started",
      "href": "/integration/getting-started"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "website": "https://evpanda.io",
      "github": "https://github.com/evpanda-labs"
    },
    "links": [
      {
        "header": "Product",
        "items": [
          {
            "label": "Dashboard",
            "href": "https://app.evpanda.io"
          },
          {
            "label": "Website",
            "href": "https://evpanda.io"
          }
        ]
      },
      {
        "header": "SDKs",
        "items": [
          {
            "label": "Go",
            "href": "https://github.com/evpanda-labs/evpanda-go"
          },
          {
            "label": "Node",
            "href": "https://github.com/evpanda-labs/evpanda-node"
          },
          {
            "label": "Python",
            "href": "https://github.com/evpanda-labs/evpanda-py"
          }
        ]
      },
      {
        "header": "Support",
        "items": [
          {
            "label": "support@evpanda.io",
            "href": "mailto:support@evpanda.io"
          }
        ]
      }
    ]
  }
}
